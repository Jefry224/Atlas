# A.R.E.S. Twin — copia este archivo a .env (está en .gitignore) y completa lo que tengas.
# Todo es opcional: sin claves, el clima usa Open-Meteo y el copiloto usa reglas locales.
# Arranque local leyendo este archivo:
#   .venv-server/bin/uvicorn server.main:app --reload --port 8000 --env-file .env

# Clima en vivo (Meteomatics). Sin esto: Open-Meteo.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_DAILY_BUDGET=900
METEOMATICS_TIMEOUT=20

# Copiloto Flight Director AI. Si están las dos, gana Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Servidor
ALLOWED_ORIGINS=http://localhost:8000
COPILOT_RATE_PER_MIN=8
COPILOT_GLOBAL_RATE_PER_MIN=60
